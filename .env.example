# Carbon-aware dispatcher credentials
# Copy this file to .env and fill in the values you need
# All keys are optional; provide only the ones for the providers you use

# EIA_API_KEY: US grid data (free, https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# GRID_STATUS_API_KEY: US grid forecasts via gridstatus.io (free tier)
GRID_STATUS_API_KEY=

# ELECTRICITY_MAPS_TOKEN: global carbon intensity (free tier, https://portal.electricitymaps.com/)
ELECTRICITY_MAPS_TOKEN=

# ENTSOE_TOKEN: Europe grid data via ENTSO-E (free, https://transparency.entsoe.eu/)
ENTSOE_TOKEN=

# GITHUB_TOKEN: required for dispatch mode to trigger workflows
GITHUB_TOKEN=
